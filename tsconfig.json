{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["index.js", "controllers/**/*.js", "models/**/*.js", "routes/**/*.js"],
  "exclude": ["node_modules"]
}
